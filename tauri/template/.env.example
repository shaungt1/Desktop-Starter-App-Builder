# Copy to .env (the builder's `setup` command does this). Never commit .env.
# Read by `tauri build` in your shell or CI, not by the app at run time.

# Update signing (auto-update module): private key from `bun run tauri signer generate`
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# macOS signing and notarization
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=
APPLE_SIGNING_IDENTITY=
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
