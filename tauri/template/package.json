    "test:watch": "vitest",
    "test:e2e": "bun run build:e2e && vitest run --config vitest.e2e.config.mts",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run test:rust",
    "doctor": "bun scripts/doctor.mjs"
  },
