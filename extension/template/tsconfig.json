{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    ".wxt/wxt.d.ts",
    "entrypoints",
    "src",
    "tests",
    "wxt.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
