# Copy to .env (the builder's `setup` command does this). Never commit .env.
# Values here are read at build time by Forge or at run time by the main process only.

# macOS signing and notarization (release builds only)
APPLE_SIGNING_IDENTITY=
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=

# GitHub publishing (bun run publish)
GITHUB_TOKEN=
